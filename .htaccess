# ----------------------------------------------------------------------
# | Force HTTPS & Canonical 301 Redirects                              |
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP to HTTPS (handles Cloudflare / reverse proxy headers)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

    # Redirect index.html to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://cloudhoste.eu/ [R=301,L]

    # Specific Page Redirects
    Redirect 301 /contact.html https://my.cloudhoste.eu/contact.php
</IfModule>

# Force correct MIME type for XML Sitemaps
<IfModule mod_mime.c>
    AddType application/xml .xml
    AddCharset utf-8 .xml
</IfModule>

# ----------------------------------------------------------------------
# | Gzip / Brotli Compression                                          |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching & Expire Headers                                    |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images & Media
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Web Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# | Cache-Control Headers (For Apache / LiteSpeed 200 OK responses)      |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|txt|xml|json|webp|png|jpe?g|gif|ico|svg|woff2?|ttf|otf)$">
        Header unset Cache-Control
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
    </FilesMatch>
</IfModule>

# LiteSpeed Specific Caching Directives
<IfModule LiteSpeed>
    CacheEnable public /
</IfModule>

# ----------------------------------------------------------------------
# | Security Headers                                                    |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Cross-Origin Opener Policy
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Strict Transport Security (Force HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Upgrade Insecure Requests CSP
    Header always set Content-Security-Policy "upgrade-insecure-requests;"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>



